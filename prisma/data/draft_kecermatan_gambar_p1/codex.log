exec
/bin/zsh -lc "set -e
svg_dir='prisma/data/draft_kecermatan_gambar_p1/svg'
actual_count="'$(find "$svg_dir" -maxdepth 1 -type f -name '"'*.svg' | wc -l | tr -d ' ')
printf 'svg_count=%s\\n' \""'$actual_count"
for n in $(seq -w 1 10)
do
  for letter in A B C D E
  do
    test -f "$svg_dir/k${n}_${letter}.svg"
  done
done
for file in "$svg_dir"/*.svg
do
  xmllint --noout "$file"
done
printf '"'xml=valid\\n'
if rg -n '<(style|text|filter|linearGradient|radialGradient)|href=' \""'$svg_dir"/*.svg
then
  exit 1
fi
printf '"'disallowed_svg_constructs=none\\n'
if rg -n 'fill=\"(?"'!#000|#fff|#9a9a9a)"|stroke="(?!#000)"'"' --pcre2 \""'$svg_dir"/*.svg
then
  exit 1
fi
printf '"'colour_palette=valid\\n'
